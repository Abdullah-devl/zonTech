<!--Main-Scripts-->
<script type="text/javascript" src="js/script.js"></script>
<script>
$(document).ready(function() {
  var form = $('#main-contact-form');
  if (!form.length) return;

  function submitToWhatsApp() {
    var nameInput = form.find('input[name="name"]');
    var emailInput = form.find('input[name="email"]');
    var phoneInput = form.find('input[name="phone"]');
    var messageInput = form.find('textarea[name="message"]');
    var statusDiv = $('#form-status');

    var name = nameInput.val().trim();
    var email = emailInput.val().trim();
    var phone = phoneInput.val().trim();
    var message = messageInput.val().trim();

    if (!name) {
      statusDiv.css({
        'background': 'rgba(239, 68, 68, 0.15)',
        'color': '#ef4444',
        'border': '1px solid #ef4444'
      })
      .html('<i class="fa fa-exclamation-circle"></i> يرجى إدخال الاسم الكامل للمتابعة.')
      .stop(true, true).slideDown();
      nameInput.focus();
      return;
    }

    if (!message) {
      statusDiv.css({
        'background': 'rgba(239, 68, 68, 0.15)',
        'color': '#ef4444',
        'border': '1px solid #ef4444'
      })
      .html('<i class="fa fa-exclamation-circle"></i> يرجى كتابة تفاصيل فكرتك أو احتياجك للمشروع.')
      .stop(true, true).slideDown();
      messageInput.focus();
      return;
    }

    // Success notification
    statusDiv.css({
      'background': 'rgba(37, 211, 102, 0.15)',
      'color': '#25D366',
      'border': '1px solid #25D366'
    })
    .html('<i class="fa fa-check-circle"></i> جاري توجيهك إلى واتساب لإرسال تفاصيل مشروعك مباشرة...')
    .stop(true, true).slideDown();

    var text = 'مرحباً ZoneTech 👋\n' +
               'طلب مشروع جديد من الموقع:\n\n' +
               '👤 *الاسم:* ' + name + '\n';
    if (phone) text += '📱 *رقم الجوال:* ' + phone + '\n';
    if (email) text += '✉️ *البريد:* ' + email + '\n';
    text += '\n📝 *تفاصيل الفكرة / المشروع:*\n' + message;

    var waUrl = 'https://wa.me/967780371289?text=' + encodeURIComponent(text);
    
    setTimeout(function() {
      window.open(waUrl, '_blank');
    }, 400);
  }

  form.on('submit', function(e) {
    e.preventDefault();
    submitToWhatsApp();
  });

  $('#send-whatsapp-btn').on('click', function(e) {
    e.preventDefault();
    submitToWhatsApp();
  });
});
</script>
</body>
